<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Android 12+ draws the splash itself: the app's colour behind the app's own mark, so the
         first frame already looks like this app. -->
    <style name="Theme.MyLibrary" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:windowSplashScreenBackground">@color/window_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>
</resources>
