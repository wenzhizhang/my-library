<?xml version="1.0" encoding="utf-8"?>
<!-- Debug only: allow cleartext to the LAN dev backend and the emulator host loopback.
     Production stays HTTPS-only (see main/res/xml/network_security_config.xml). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">192.168.1.20</domain>
    </domain-config>
</network-security-config>
